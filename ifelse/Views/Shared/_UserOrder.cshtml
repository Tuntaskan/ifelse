<!-- Cart -->
@if (TempData["CartError"] != null)
{
    <div class="alert alert-danger">
        @TempData["CartError"]
    </div>
}

@if (TempData["CartSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["CartSuccess"]
    </div>
}

<div class="card p-3 mt-5">

    <h4>Cart</h4>

    @if (Model.Cart != null && Model.Cart.Any())
    {
        foreach (var item in Model.Cart)
        {
            <p>
                @item.MenuName
                x @item.Qty
                =
                Rp @item.Subtotal.ToString("#,##0").Replace(",", ".")
            </p>
        }

        <hr />

        <button type="button"
                onclick="openPaymentPopup()"
                class="btn btn-primary rounded-1">

            Checkout

        </button>

        <form asp-controller="UserOrder"
              asp-action="ResetCheckout"
              method="post"
              class="mt-2">

            <button type="submit"
                    class="btn btn-outline-secondary rounded-1 w-100">

                Reset Checkout

            </button>

        </form>
    }
    else
    {
        <p>Cart Empty</p>

        @if (Model.LastOrder != null)
        {
            <form asp-controller="UserOrder"
                  asp-action="ResetCheckout"
                  method="post"
                  class="mt-2">

                <button type="submit"
                        class="btn btn-outline-secondary rounded-1 w-100">

                    Reset Checkout

                </button>

            </form>
        }
    }

</div>


<!-- PAYMENT POPUP -->
<div id="paymentPopup"
     style="display:none;
            position:fixed;
            top:50%;
            left:50%;
            transform:translate(-50%,-50%);
            background:white;
            padding:30px;
            border-radius:12px;
            z-index:9999;
            width:400px;">

    <h3>Checkout</h3>

    <form asp-controller="UserOrder"
          asp-action="Checkout"
          method="post">

        @{
            var roleId = Context.Session.GetInt32("roleId");
            var fullName = Context.Session.GetString("fullname");
        }

        <!-- MEMBER -->
        @if (roleId == 6)
        {
            <input type="text"
                   name="customerName"
                   value="@fullName"
                   class="form-control mb-2"
                   readonly />
        } else {
            <input type="text"
                   name="customerName"
                   placeholder="Nama"
                   class="form-control mb-2"
                   />
        }

        <!-- Request -->
        <input type="text"
               name="customerRequest"
               placeholder="Request (opsional)"
               class="form-control mb-3" />


        <!-- PILIH MEJA KHUSUS MEMBER -->
        @if (roleId == 6)
        {
            <label class="form-label">Reservation Date</label>

            <input type="date"
                   name="reservationDate"
                   class="form-control mb-3"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />

            <h5 class="mb-3">Pick Table</h5>

            <div class="table-grid mb-4">

                @foreach (var meja in Model.Tables)
                {
                    var isBooked =
                    meja.Status == "Booked"
                    || meja.Status == "Occupied";

                    <label class="seat-selector">

                        <input type="radio"
                               name="tableId"
                               value="@meja.TableId"
                               hidden
                               @(isBooked ? "disabled" : "") />

                        <div class="seat-box
                                @(isBooked ? "seat-full" : "seat-empty")">

                            <span>
                                @meja.TableNumber
                            </span>

                            <small>
                                @meja.Status
                            </small>

                        </div>

                    </label>
                }

            </div>
        }


        <!-- PAYMENT -->
        <select id="paymentMethod"
                name="paymentMethod"
                class="form-control mb-3"
                onchange="toggleQris()">

            <option value="Cash">
                Cash
            </option>

            <option value="QRIS">
                QRIS
            </option>

        </select>

        <div id="qrisUpload" class="mb-2" style="display:none;">
            <label>QRIS Payment Proof</label>
            <input type="file"
                   name="QrisPhoto"
                   class="form-control"
                   accept="image/*" />
        </div>

        <script>
            function toggleQris() {
                const method = document.getElementById("paymentMethod").value;
                const qrisDiv = document.getElementById("qrisUpload");
                qrisDiv.style.display = method === "QRIS" ? "block" : "none";
            }
        </script>


        <!-- QRIS -->
        <div id="qrisSection"
             style="display:none;
                text-align:center;
                margin-bottom:20px;">

            <h5>Scan QRIS</h5>

            <img src="~/images/qris.png"
                 width="200" />

        </div>


        <button type="submit"
                class="btn btn-primary w-100">

            Confirm Order

        </button>

        <button type="button"
                onclick="closePaymentPopup()"
                class="btn btn-secondary w-100 mt-2">

            Close

        </button>

    </form>

</div>



