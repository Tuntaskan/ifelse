@model ifelse.Models.User

<form asp-action="EditUser" method="post">

    <div class="modal-header">
        <h5>Edit User</h5>
    </div>

    <div class="modal-body">

        <input type="hidden" asp-for="UserId" />

        <label>Fullname</label>
        <input asp-for="FullName"
               class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

        <label>Username</label>
        <input asp-for="Username"
               class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

        <div>
            <label>Password</label>
        <input asp-for="PasswordHash"
                   class="form-control mb-2" id="passwordBox" style="border: 1px solid black; border-radius: 10px;" />
        </div>

        <label>Phone Number</label>
        <input asp-for="Phone"
               class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

        <label>Email</label>
        <input asp-for="Email"
               class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

        <label>Role</label>
        <select asp-for="RoleId"
                class="form-select mb-2" style="border: 1px solid black; border-radius: 10px;">

            <option value="1">Admin</option>
            <option value="2">Supervisor</option>
            <option value="3">Kasir</option>
            <option value="4">Kitchen</option>
            <option value="5">Owner</option>
            <option value="6">Member</option>

        </select>

        <input asp-for="Status"
               class="form-control" style="border: 1px solid black; border-radius: 10px;" />

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

    </div>

</form>
<script>
                 function togglePassword() {

        let x = document.getElementById("passwordBox");

        if (x.type === "password")
            x.type = "text";
        else
            x.type = "password";
    }
            </script>