@model ifelse.Models.Order
@using ifelse.Models
@{
    var tables = ViewBag.Tables as List<TableMeja> ?? new List<TableMeja>();
}

<div class="modal fade" id="statusModal-@Model.OrderId">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="UpdateStatus" method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.OrderId" />

                <div class="modal-header">
                    <h5>Update Status</h5>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Payment Status</label>
                        <select name="paymentStatus" class="form-control">
                            <option selected="@(Model.PaymentStatus == "Pending" ? "selected" : null)">Pending</option>
                            <option selected="@(Model.PaymentStatus == "Paid" ? "selected" : null)">Paid</option>
                            <option selected="@(Model.PaymentStatus == "Unpaid" ? "selected" : null)">Unpaid</option>
                        </select>
                    </div>

                    <label class="form-label">Status Order</label>
                    <select name="status" class="form-control">
                        <option>Waiting</option>
                        <option>Cooking</option>
                        <option>Done</option>
                    </select>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-primary">
                        Update
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
