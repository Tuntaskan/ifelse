@{
    var menus = ViewBag.Menus as List<ifelse.Models.MenuModel>;
}
<div class="modal fade" id="createModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="Create" method="post">

                <div class="modal-header">
                    <h5>New Transaction</h5>
                </div>

                <div class="modal-body">

                    <label class="fw-bold">Customer Id</label>
                    <input name="CustomerId" class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

                    <label class="fw-bold">Table</label>
                    <input name="TableId" class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

                    <label class="fw-bold">Menu</label>
                    <select name="MenuId" class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" >

                        @if (menus != null)
                        {
                            foreach (var menu in menus)
                            {
                                <option value="@menu.MenuId">
                                    @menu.MenuName - @menu.Price
                                </option>
                            }
                        }                        
                    </select>

                    <label class="fw-bold">Total</label>
                    <input name="TotalPrice" class="form-control mb-2" style="border: 1px solid black; border-radius: 10px;" />

                    <label class="fw-bold">Payment</label>
                    <select name="PaymentStatus" class="form-control" style="border: 1px solid black; border-radius: 10px;">
                        <option>Paid</option>
                        <option>Unpaid</option>
                    </select>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-success">
                        Save
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>