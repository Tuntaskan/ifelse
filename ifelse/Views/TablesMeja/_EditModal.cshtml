@model ifelse.Models.TableMeja

<div class="modal fade" id="editTableModal-@Model.TableId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="TablesMeja"
                  asp-action="UpdateAvailability"
                  method="post">
                <input type="hidden" name="id" value="@Model.TableId" />

                <div class="modal-header">
                    <h5 class="modal-title">Edit Table Available @Model.TableNumber</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <label class="form-label">Table Status</label>
                    <select name="status" class="form-control">
                        <option selected="@(Model.Status == "Available" ? "selected" : null)">Available</option>
                        <option selected="@(Model.Status == "Booked" ? "selected" : null)">Booked</option>
                        @* <option selected="@(Model.Status == "Occupied" ? "selected" : null)">Occupied</option> *@
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
