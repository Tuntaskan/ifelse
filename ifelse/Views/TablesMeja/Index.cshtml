@model List<ifelse.Models.TableMeja>
@{
    Layout = "_EveryLayout";
    ViewData["Title"] = "Tables Meja";

    var fullTables = Model.Count(x => x.Status == "Booked" || x.Status == "Occupied");
    var availableTables = Model.Count - fullTables;
}


    <section style="background-image: url('images/banner0.png'); background-repeat: no-repeat; background-size: cover;">
        <div class="container-lg">
            <div class="row">
                <div class="col-lg-6 pt-5 mt-5">
                    <h2 class="display-1 ls-1"><span class="fw-bold text-primary">PLANARCAFEA</span> <span class="fw-bold">Tables Row</span></h2>
                    <p class="fs-4"></p>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-5">
        <div class="container-lg">
            <div class="row mt-4">
                <div class="col-md-12">
                    @if (TempData["TableError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["TableError"]</div>
                    }

                    @if (TempData["TableSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["TableSuccess"]</div>
                    }

                    <div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-3 my-4">
                        <div>
                            <h2 class="section-title mb-1">Table List</h2>
                            <p class="mb-0">Table Grid.</p>
                        </div>

                        <button class="btn btn-primary rounded-1"
                                data-bs-toggle="modal"
                                data-bs-target="#createTableModal">
                            Add Table
                        </button>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-white h-100 text-center">
                        <div class="small text-muted">Total Table</div>
                        <div class="display-6 fw-bold">@Model.Count</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-white h-100 text-center">
                        <div class="small text-muted">Table Available</div>
                        <div class="display-6 fw-bold text-success">@availableTables</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-white h-100 text-center">
                        <div class="small text-muted">Table Full</div>
                        <div class="display-6 fw-bold text-danger">@fullTables</div>
                    </div>
                </div>
            </div>

            <div class="border rounded p-4 bg-white shadow-sm mb-4">
                <div class="screen-label text-center mb-4">Area Meja</div>

                @if (Model.Any())
                {
                    <div class="table-grid">
                        @foreach (var meja in Model)
                        {
                            var isFull = meja.Status == "Booked" || meja.Status == "Occupied";

                            <div class="seat-card">
                                <div class="seat-box @(isFull ? "seat-full" : "seat-empty")">
                                    <span>Table @meja.TableNumber</span>
                                    <small>@meja.Status</small>
                                </div>

                                <button class="btn btn-outline-primary btn-sm mt-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editTableModal-@meja.TableId">
                                    Edit Status
                                </button>
                            </div>

                            @await Html.PartialAsync("_EditModal", meja)
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        No Table Added.
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap gap-3 align-items-center">
                <div class="legend-item">
                    <span class="legend-box legend-empty"></span>
                    Available
                </div>
                <div class="legend-item">
                    <span class="legend-box legend-full"></span>
                    Full
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_CreateModal", new ifelse.Models.TableMeja())

<style>
    .screen-label {
        max-width: 260px;
        margin: 0 auto;
        padding: 10px 16px;
        border-radius: 999px;
        background: #f3f3f3;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .table-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 14px;
    }

    .seat-box {
        min-height: 90px;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-weight: 700;
        border: 2px solid #ddd;
        padding: 12px;
    }

    .seat-card {
        display: flex;
        flex-direction: column;
    }

    .seat-box small {
        font-size: 0.8rem;
        font-weight: 600;
        margin-top: 4px;
    }

    .seat-empty {
        background: #eef9f0;
        border-color: #7cc48b;
        color: #27714E;
    }

    .seat-full {
        background: #f3d8d8;
        border-color: #cc7f7f;
        color: #8a2d2d;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
    }

    .legend-box {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        display: inline-block;
    }

    .legend-empty {
        background: #eef9f0;
        border: 1px solid #7cc48b;
    }

    .legend-full {
        background: #f3d8d8;
        border: 1px solid #cc7f7f;
    }

    .seat-card .btn {
        pointer-events: auto;
    }
</style>

<script src="js/jquery-1.11.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
<script src="js/plugins.js"></script>
<script src="js/script.js"></script>
